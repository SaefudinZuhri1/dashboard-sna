# Salin file ini menjadi .streamlit/secrets.toml pada komputer lokal.
# Jangan commit file secrets.toml yang berisi API key asli.

[gemini]
api_key = "GANTI_DENGAN_API_KEY_GEMINI_KAMU"

[database]
path = "database/users.db"

[models]
indihome_path = "models/indihome"
indibiz_path = "models/indibiz"
telkomsel_path = "models/telkomsel"
