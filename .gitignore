# Path: .gitignore

# Rahasia dan konfigurasi lokal
.env
.env.*
!.env.example
!.env.template
.streamlit/secrets.toml
.streamlit/secrets.toml.backup*
.streamlit/secrets.toml.bak*

# Python cache dan artefak build
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environment
venv/
.venv/
env/
venv*/
.venv*/
venv_lama_error_torch/

# Model files — terlalu besar untuk GitHub
models/indihome/*.bin
models/indihome/*.safetensors
models/indibiz/*.bin
models/indibiz/*.safetensors
models/telkomsel/*.bin
models/telkomsel/*.safetensors
*.pkl
*.bin
*.safetensors
*.pt
*.pth

# Cache HuggingFace lokal
.cache/

# Folder data TIDAK diabaikan agar file dataset dapat di-push ke branch cloud.
# Jangan memasukkan data sensitif atau file di atas batas GitHub.

# Database lokal pengguna
database/users.db

# Editor dan sistem operasi
.vscode/
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# Log, file sementara, dan backup
*.log
*.tmp
*.temp
*.bak

# Artefak backup lokal proyek
.fase20_backup/
PATCH_BACKUP_FASE20/
backup_tahap5_fase11/
