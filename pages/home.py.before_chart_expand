def _build_platform_chart(sentiment_df: pd.DataFrame) -> go.Figure:
    """Buat horizontal grouped bar distribusi sentimen per platform."""
    grouped = (
        sentiment_df.groupby(["platform", "sentiment"])
        .size()
        .unstack(fill_value=0)
        .reindex(index=PLATFORM_ORDER, columns=SENTIMENT_ORDER, fill_value=0)
    )
    figure = go.Figure()
    for sentiment in SENTIMENT_ORDER:
        figure.add_trace(
            go.Bar(
                name=SENTIMENT_LABELS[sentiment],
                y=[PLATFORM_LABELS[item] for item in PLATFORM_ORDER],
                x=grouped[sentiment].astype(int).tolist(),
                orientation="h",
                marker_color=SENTIMENT_COLORS[sentiment],
                hovertemplate=(
                    f"{SENTIMENT_LABELS[sentiment]}<br>"
                    "%{y}: %{x:,} komentar<extra></extra>"
                ),
            )
        )
    figure.update_layout(
        barmode="group",
        height=390,
        margin={"l": 18, "r": 18, "t": 20, "b": 55},
        paper_bgcolor="rgba(0,0,0,0)",
        plot_bgcolor="rgba(0,0,0,0)",
        font={"color": _chart_text_color(), "size": 11},
        legend={"orientation": "h", "yanchor": "bottom", "y": 1.02, "xanchor": "left", "x": 0},
        xaxis={
            "title": "Jumlah Komentar",
            "gridcolor": "rgba(128,128,128,0.18)",
            "zeroline": False,
            "rangemode": "tozero",
        },
        yaxis={"title": "Platform", "categoryorder": "array", "categoryarray": [PLATFORM_LABELS[item] for item in reversed(PLATFORM_ORDER)]},
        hoverlabel={"namelength": -1},
    )
    return figure


def _render_platform_fallback(sentiment_df: pd.DataFrame) -> None:
    """Tampilkan tabel ringkas jika chart platform gagal dirender."""
    try:
        fallback = (
            sentiment_df.groupby(["platform", "sentiment"])
            .size()
            .unstack(fill_value=0)
            .reindex(index=PLATFORM_ORDER, columns=SENTIMENT_ORDER, fill_value=0)
            .reset_index()
        )
        fallback["platform"] = fallback["platform"].map(PLATFORM_LABELS)
        fallback = fallback.rename(
            columns={
                "platform": "Platform",
                "positive": "Positif",
                "neutral": "Netral",
                "negative": "Negatif",
            }
        )
        st.dataframe(fallback, hide_index=True, use_container_width=True)
    except Exception:
        st.error("Ringkasan distribusi platform belum dapat ditampilkan.")


def _render_influencer_table(influencer_df: pd.DataFrame, is_real: bool) -> None:
    """Render Top 5 influencer sebagai tabel HTML yang sudah disanitasi."""
    try:
        identified = influencer_df[influencer_df["teridentifikasi"]].copy()
        if identified.empty:
            identified = influencer_df.copy()
        top_five = identified.sort_values(
            ["interaksi", "followers", "username"],
            ascending=[False, False, True],
        ).head(5)
        if top_five.empty:
            st.info("Data influencer belum tersedia.")
            return

        rows = []
        for rank, row in enumerate(top_five.itertuples(index=False), start=1):
            username = escape(str(row.username))
            platform = escape(PLATFORM_LABELS.get(str(row.platform), str(row.platform).title()))
            followers = escape(_format_number(row.followers))
            interactions = escape(_format_number(row.interaksi))
            rows.append(
                "<tr>"
                f"<td>{rank}</td>"
                f"<td>@{username}</td>"
                f'<td><span class="home-v5-platform-pill">{platform}</span></td>'
                f"<td>{followers}</td>"
                f"<td>{interactions}</td>"
                "</tr>"
            )

        source_class = "home-v5-badge-real" if is_real else "home-v5-badge-dummy"
        source_label = "Data Aktual" if is_real else "Data Dummy"
        st.markdown(
            f"""
            <div style="margin-bottom:0.55rem;">
                <span class="home-v5-badge {source_class}">{source_label}</span>
            </div>
            <div class="home-v5-table-wrap">
                <table class="home-v5-table">
                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Username</th>
                            <th>Platform</th>
                            <th>Followers</th>
                            <th>Interaksi</th>
                        </tr>
                    </thead>
                    <tbody>{''.join(rows)}</tbody>
                </table>
            </div>
            """,
            unsafe_allow_html=True,
        )
    except Exception:
        st.error("Tabel Top 5 Influencer belum dapat ditampilkan.")


def _render_overview(
    sentiment_df: pd.DataFrame,
    influencer_df: pd.DataFrame,
    influencer_real: bool,
) -> None:
    """Render overview dua kolom: chart platform dan tabel influencer."""
    try:
        st.markdown('<div class="home-v5-section-title">Overview Data</div>', unsafe_allow_html=True)
        chart_col, table_col = st.columns([1.15, 0.85])
        with chart_col:
            st.markdown('<div class="home-v5-card-title">Distribusi Sentimen per Platform</div>', unsafe_allow_html=True)
            try:
                st.plotly_chart(
                    _build_platform_chart(sentiment_df),
                    use_container_width=True,
                    config={"displayModeBar": False, "responsive": True},
                    key="home_v5_platform_sentiment",
                )
            except Exception:
                st.error("Chart distribusi sentimen belum dapat ditampilkan.")
                _render_platform_fallback(sentiment_df)

        with table_col:
            st.markdown('<div class="home-v5-card-title">Top 5 Influencer</div>', unsafe_allow_html=True)
            _render_influencer_table(influencer_df, influencer_real)
